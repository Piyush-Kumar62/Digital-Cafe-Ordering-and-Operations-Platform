# ==============================
# Production Environment Template
# ==============================

# App
APP_NAME=Digital Cafe Platform
SPRING_PROFILES_ACTIVE=deploy
FRONTEND_URL=https://cafehub.tech
CORS_ALLOWED_ORIGINS=https://cafehub.tech,https://www.cafehub.tech
APP_STORAGE_PROVIDER=s3
APP_UPLOAD_DIR=/var/app/uploads
APP_DEV_SEED_ENABLED=false
APP_DATA_INIT_ENABLED=false

# Container images (required for docker-compose.prod.yml)
# Example for GHCR:
# BACKEND_IMAGE=ghcr.io/your-github-username/digital-cafe-backend:latest
# FRONTEND_IMAGE=ghcr.io/your-github-username/digital-cafe-frontend:latest
BACKEND_IMAGE=ghcr.io/your-org/digital-cafe-backend:latest
FRONTEND_IMAGE=ghcr.io/your-org/digital-cafe-frontend:latest

# Database (MySQL)
DB_HOST=your-rds-endpoint
DB_PORT=3306
DB_NAME=digital_cafe_db
DB_USERNAME=admin
DB_PASSWORD=replace_me
# Optional explicit JDBC URL (overrides host/port/db)
# DB_URL=jdbc:mysql://your-rds-endpoint:3306/digital_cafe_db?useSSL=true&serverTimezone=UTC

# JWT
JWT_SECRET=replace_with_32byte_or_longer_secret
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# Email
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
MAIL_FROM_EMAIL=replace_me
MAIL_FROM_NAME=Digital Cafe Team
MAIL_ENABLED=true

# Payment
PAYMENT_GATEWAY=RAZORPAY
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

# AWS S3 (required when APP_STORAGE_PROVIDER=s3)
AWS_REGION=ap-south-1
S3_BUCKET=your-s3-bucket-name
# Prefer IAM role on EC2; keep these blank when role is used.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
