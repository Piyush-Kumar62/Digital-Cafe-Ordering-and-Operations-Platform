# Root .gitignore for Digital Cafe Platform

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
ehthumbs.db

# IDE/editor
.vscode/
.idea/
*.swp
*.swo
*~
.properties
# Environment/secrets
.env
.env.local
.env.*.local
*.key
*.pem
*.p12
*.jks
*-secret.*
credentials.json
secrets.json

# Logs/temp
*.log
logs/
*.tmp
*.temp
*.bak
*.backup
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local materials and generated assets
Project Materials/
Local MySQL.session.sql
digital-cafe-backend/uploads/
uploads/
docs/uploads/

# Agent/automation instructions (not for source control)
PROJECT_AGENT_INSTRUCTIONS.md

# Build/test output logs (generated files, not source)
digital-cafe-backend/compile_output.txt
digital-cafe-backend/compile_errors.txt
digital-cafe-backend/compile_errors2.txt
digital-cafe-backend/compile_errors3.txt
digital-cafe-backend/clean_compile_output.txt
digital-cafe-backend/clean_compile_output2.txt
digital-cafe-backend/maven_output.txt
digital-cafe-backend/single_test_log.txt
digital-cafe-backend/test_logs.txt

# Security — auth tokens and test artifacts (never commit)
digital-cafe-backend/login.json
digital-cafe-backend/token.txt
digital-cafe-backend/nul
nul

# Ad-hoc test scripts (local only)
test_apis.sh
test_dashboard.sh
test_full_flow.sh
test_full_flow.sh
test_output.txt

# Sensitive / environment-specific config (local only)
digital-cafe-backend/.env
.env

# Dev application config — contains fallback DB password and JWT secret
digital-cafe-backend/src/main/resources/application.properties
digital-cafe-backend/src/main/resources/application.properties.example

# Database session files
*.session.sql

# Build/cache (workspace level)
/.angular/cache
digital-cafe-frontend/dist/
digital-cafe-frontend/node_modules/
Explain.md
PROJECT_AGENT_INSTRUCTIONS.md
JPA_ENTITY_STRUCTURE_BLUEPRINT.md
file-storage-and-cafe-setup.md
PRODUCTION_DATABASE_SCHEMA_ANALYSIS.md
docs/sql
digital-cafe-frontend/Dockerfile
digital-cafe-frontend/nginx.conf
