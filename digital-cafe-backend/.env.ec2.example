# Deployment / EC2 example environment
# Use AWS SSM Parameter Store + scripts/render-env-from-ssm.sh to generate real .env.

DB_URL=jdbc:mysql://your-rds-endpoint.ap-south-1.rds.amazonaws.com:3306/digital_cafe_db?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_rds_username
DB_PASSWORD=your_rds_password

JWT_SECRET=replace_with_64_plus_char_secret
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

FRONTEND_URL=https://cafehub.tech

PAYMENT_GATEWAY=TEST
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
MAIL_FROM_EMAIL=replace_me
MAIL_FROM_NAME=Digital Cafe Team

APP_STORAGE_PROVIDER=s3
S3_BUCKET=replace_me
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me

SERVER_PORT=8080
