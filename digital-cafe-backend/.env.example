# ==============================
# Local Development Environment
# ==============================
APP_NAME=Digital Cafe Platform
APP_DATA_INIT_ENABLED=true
APP_DEV_SEED_ENABLED=true
FRONTEND_URL=http://localhost:4200
SERVER_PORT=8080
APP_STORAGE_PROVIDER=local
APP_UPLOAD_DIR=uploads

# Database (MySQL local)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=digital_cafe_db
DB_USERNAME=root
DB_PASSWORD=replace_me

# JWT
JWT_SECRET=replace_with_local_secret
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Email (optional for local)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Digital Cafe Team
MAIL_ENABLED=false

# Payment (optional for local)
PAYMENT_GATEWAY=TEST
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AWS / S3 (optional in local because storage provider is local)
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
