# ============================================================
# Digital Cafe Backend — Environment Variables (.env.example)
# ============================================================
# Copy this file to .env and fill in your real values.
# The .env file is loaded automatically at startup via
# spring.config.import=optional:dotenv:./.env
# NEVER commit the real .env file to version control.
# ============================================================

# ─── Database ───────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/digital_cafe_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_hex_string_at_least_64_chars

# ─── Email (Gmail SMTP) ─────────────────────────────────────
# HOW TO SET UP GMAIL SMTP:
#   1. Enable 2-Step Verification on your Google account:
#      https://myaccount.google.com/security
#   2. Generate an App Password at:
#      https://myaccount.google.com/apppasswords
#      (Select app: "Mail", device: "Other" → give it a name)
#   3. Copy the 16-character App Password shown.
#   4. Set MAIL_USERNAME to your full Gmail address.
#   5. Set MAIL_PASSWORD to the 16-character App Password (no spaces).
#
# MAIL_HOST and MAIL_PORT can be omitted — they default to smtp.gmail.com:587.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_char_app_password
# The "From:" address — must match (or be an alias of) your Gmail account.
MAIL_FROM_EMAIL=your_gmail_address@gmail.com
EMAIL_FROM_NAME=Digital Cafe Team

# Set to false to disable all outbound email during development / testing:
# MAIL_ENABLED=false

# ─── Application URLs ────────────────────────────────────────
FRONTEND_URL=http://localhost:4200
EMAIL_SUPPORT_URL=http://localhost:4200/contact

# ─── Optional: Razorpay (Payment) ───────────────────────────
# RAZORPAY_KEY_ID=rzp_test_xxx
# RAZORPAY_KEY_SECRET=xxxxxxxx

# ─── Optional: AWS S3 (File Storage) ────────────────────────
# APP_STORAGE_PROVIDER=s3
# S3_BUCKET=your-bucket-name
# AWS_REGION=ap-south-1
# S3_BASE_URL=https://your-bucket.s3.amazonaws.com
# AWS_ACCESS_KEY_ID=xxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxx
