SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

FRONTEND_URL=https://your-domain.com
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=3306
DB_NAME=digital_cafe_db
DB_USERNAME=admin
DB_PASSWORD=replace_me

JWT_SECRET=replace_with_prod_secret_32_bytes_or_more
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace_me
MAIL_PASSWORD=replace_me
MAIL_FROM_EMAIL=no-reply@your-domain.com
EMAIL_FROM_NAME=Digital Cafe Team

PAYMENT_GATEWAY=RAZORPAY
RAZORPAY_KEY_ID=replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_WEBHOOK_SECRET=replace_me

APP_DATA_INIT_ENABLED=false
APP_EDUCATION_SEED_ENABLED=true
APP_EDUCATION_AUTO_IMPORT_ENABLED=false
APP_EDUCATION_IMPORT_SYNC=true
APP_EDUCATION_IMPORT_DEGREES_ENABLED=true
APP_EDUCATION_IMPORT_BRANCHES_ENABLED=true

APP_STORAGE_PROVIDER=s3
APP_UPLOAD_DIR=/var/app/uploads
S3_BUCKET=your-s3-bucket
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

BACKEND_IMAGE=ghcr.io/your-github-username/digital-cafe-backend:latest
FRONTEND_IMAGE=ghcr.io/your-github-username/digital-cafe-frontend:latest
