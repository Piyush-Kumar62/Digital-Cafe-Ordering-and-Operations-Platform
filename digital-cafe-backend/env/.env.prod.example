SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

FRONTEND_URL=https://your-domain.com
ADMIN_EMAIL=cafehub.admin@gmail.com
APP_ADMIN_BOOTSTRAP_ENABLED=true
APP_CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=digital_cafe_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_SSL_MODE=require

JWT_SECRET=replace_with_prod_secret_32_bytes_or_more
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASS=your_brevo_smtp_password
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=no-reply@cafehub.tech
EMAIL_FROM_NAME=CafeHub
MAIL_SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_SMTP_TIMEOUT_MS=8000
MAIL_SMTP_WRITE_TIMEOUT_MS=8000
EMAIL_ASYNC_CORE_POOL_SIZE=4
EMAIL_ASYNC_MAX_POOL_SIZE=12
EMAIL_ASYNC_QUEUE_CAPACITY=500
EMAIL_ASYNC_AWAIT_TERMINATION_SECONDS=45

PAYMENT_GATEWAY=RAZORPAY
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

APP_DATA_INIT_ENABLED=false
APP_EDUCATION_SEED_ENABLED=true
APP_EDUCATION_AUTO_IMPORT_ENABLED=false
APP_EDUCATION_IMPORT_SYNC=true
APP_EDUCATION_IMPORT_DEGREES_ENABLED=true
APP_EDUCATION_IMPORT_BRANCHES_ENABLED=true

APP_STORAGE_PROVIDER=s3
APP_UPLOAD_DIR=/var/app/uploads
S3_BUCKET=your-s3-bucket
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

BACKEND_IMAGE=ghcr.io/your-github-username/digital-cafe-backend:latest
FRONTEND_IMAGE=ghcr.io/your-github-username/digital-cafe-frontend:latest
