{
  "name": "digital-cafe-frontend",
  "version": "1.0.0",
  "description": "Digital Café Ordering and Operations Platform - Angular Frontend",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint",
    "serve:deployment": "ng serve --configuration deployment",
    "e2e": "cypress run",
    "e2e:api": "cypress run --browser chrome --headless --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "e2e:ui": "cypress run --browser chrome --headless --spec \"cypress/e2e/ui/**/*.cy.ts\"",
    "e2e:open": "cypress open"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/material": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@stomp/stompjs": "^7.0.0",
    "@swimlane/ngx-charts": "^23.1.0",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "ng2-charts": "^8.0.0",
    "primeicons": "^7.0.0",
    "primeng": "^20.4.0",
    "rxjs": "~7.8.1",
    "sockjs-client": "^1.6.1",
    "sweetalert2": "^11.26.22",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jasmine": "^5.1.7",
    "@types/sockjs-client": "^1.5.4",
    "angular-eslint": "21.0.1",
    "autoprefixer": "^10.4.0",
    "cypress": "^14.3.3",
    "eslint": "^9.39.1",
    "jasmine-core": "^5.7.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "8.46.4"
  }
}
